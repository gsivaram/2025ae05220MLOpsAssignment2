# Copy to .env (git-ignored) and fill in:   cp .env.example .env
# The notebook loads this file with python-dotenv; the key is never printed or logged.

# --- LLM provider (default: Google Gemini, free tier) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=paste-your-key-here

# --- Optional alternatives (set LLM_PROVIDER / LLM_MODEL accordingly) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local open-source model, no key

# --- Optional tuning ---
# REQUEST_INTERVAL_SECONDS=6    # pause between calls (free tier = ~10 requests/min)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
